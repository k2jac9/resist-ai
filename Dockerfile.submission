FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libxrender1 libxext6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-submission.txt .
RUN pip install --no-cache-dir -r requirements-submission.txt
COPY src/ src/
RUN groupadd --gid 10001 resistai && useradd --uid 10001 --gid 10001 --no-create-home resistai \
    && mkdir /data && chown resistai:resistai /data
USER 10001:10001
ENV RESISTAI_UI_HOST=0.0.0.0 RESISTAI_QUOTA_DB=/data/attempts.sqlite3 PORT=7860
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','7860')+'/healthz',timeout=3)"
CMD ["python", "-m", "src.submission_app"]
