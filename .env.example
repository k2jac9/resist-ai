# Server-side credentials only. Empty keys keep provider operations unavailable.
NVIDIA_API_KEY=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional local protein-model downloads. Not needed for Evidence Review.
HF_TOKEN=

# Gradio UI: local by default. Public/container binding requires both auth values.
RESISTAI_HOST=127.0.0.1
PORT=7860
RESISTAI_UI_USER=
RESISTAI_UI_PASSWORD=
GRADIO_ANALYTICS_ENABLED=False

# REST API security is separate from Gradio authentication.
RESISTAI_API_KEY=
# Local development only. Does not bypass public Gradio authentication.
RESISTAI_ALLOW_NO_AUTH=
RESISTAI_CORS_ORIGINS=
RESISTAI_ALLOW_PRIVATE_WEBHOOKS=
