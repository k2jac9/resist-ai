# NVIDIA NIM Biology APIs (required for live pipeline)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Nebius AI Studio (required for LLM reasoning)
NEBIUS_API_KEY=your_nebius_api_key_here

# Optional: HuggingFace (ESM-2 works without it, just slower downloads)
HF_TOKEN=your_huggingface_token_here

# --- REST API security (src/api/server.py) ---
# Required to enable the API. The server fails closed: without this key all
# endpoints return 503 (unless RESISTAI_ALLOW_NO_AUTH is set). Clients send it
# as the X-API-Key header.
RESISTAI_API_KEY=

# Set to "true" to run the API with NO authentication (local dev only).
RESISTAI_ALLOW_NO_AUTH=

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com).
# Empty = no cross-origin browser access. Never use "*" with credentials.
RESISTAI_CORS_ORIGINS=

# Set to "true" to allow webhooks to non-public/HTTP URLs (local dev only).
RESISTAI_ALLOW_PRIVATE_WEBHOOKS=
