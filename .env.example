# NVIDIA NIM Biology APIs (required for live pipeline)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Nebius AI Studio (required for LLM reasoning)
NEBIUS_API_KEY=your_nebius_api_key_here

# REST API auth: when set, callers must send this value as the X-API-Key header.
# Leave unset only for local development -- the API is unauthenticated without it.
RESISTAI_API_KEY=

# Comma-separated list of allowed CORS origins for the REST API (optional).
# Defaults to localhost dev hosts if unset.
# RESISTAI_CORS_ORIGINS=https://app.example.com
